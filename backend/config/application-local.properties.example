# URL de la base "cc" en MySQL/MariaDB dentro de la maquina virtual
spring.datasource.url=jdbc:mysql://localhost:3306/cc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Usuario creado con database/02_usuario_aplicacion.sql
spring.datasource.username=carritogt
spring.datasource.password=ESCRIBA_AQUI_SU_CONTRASENA

